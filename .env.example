# Copy to .env.local and replace required values with your Supabase project settings.
# Supabase public URL and publishable/anon key are required to start the app.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-scoped aliases for the same public values. Used when the runtime cannot see the
# NEXT_PUBLIC_* names (for example inside the Cloudflare feed worker).
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_ANON_KEY=

# Required in production for distributed API rate limiting; optional in development.
REDIS_URL=redis://localhost:6379

# Optional server-side integrations.
# SUPABASE_SERVICE_ROLE_KEY / SUPABASE_SECRET_KEY bypass Row Level Security. Only ever set these
# under these server-scoped names: Next.js inlines every NEXT_PUBLIC_* variable into the client
# bundle at build time, so a service-role key stored under a NEXT_PUBLIC_ name is published to
# every visitor.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_VISION_MODEL=llama-4-scout-17b-16e-instruct
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
SPOTS_API=
NEXT_PUBLIC_SPOTS_API_URL=

# Rate limiting / data sources (optional overrides).
RATE_LIMIT_ALLOW_LOCAL_FALLBACK=
CLOUDFLARE_WORKER_FEED_SECRET=
USGS_BASE=
NWS_BASE=
OPEN_METEO_FORECAST=
OPEN_METEO_MARINE=

# Populate Vercel + Supabase values automatically: `npm run env:sync` (add `-- development --push`
# to upload derived aliases/defaults back to Vercel).

  +++ b/src/lib/spotsLoader.ts
  +export type Spot = { id: string; name: string; lat:
  number; lon: number; source: 'LIVE'|'CACHE'|'OFFLINE' };
  +export type DataSourceKind = 'LIVE'|'CACHE'|'OFFLINE';
  +
  +export async function loadLiveSpots(): Promise<{ spots:
  Spot[]; source: DataSourceKind; timestamp?: string }> {
  +  try {
  +    const res = await fetch('/api/live-spots', { cache:
  'no-store' });
  +    if (res.ok) {
  +      const data: any = await res.json();
  +      const spotsRaw = Array.isArray(data?.spots) ?
  data.spots : [];
  +      const spots: Spot[] = spotsRaw.map((s: any) => ({
  +        id: s.id ?? `${s.lat ?? 0}:${s.lon ?? 0}`,
  +        name: s.name ?? 'Unknown',
  +        lat: s.lat ?? 0,
  +        lon: s.lon ?? 0,
  +        source: 'LIVE',
  +      }));
  +      return { spots, source: 'LIVE', timestamp:
  data.timestamp };
  +    }
  +  } catch {
  +    // fall through to offline
  +  }
  +  const offline: Spot = { id: 'offline-1', name:
  'Offline Spot', lat: 0, lon: 0, source: 'OFFLINE' };
  +  return { spots: [offline], source: 'OFFLINE',
  timestamp: new Date().toISOString() };
  +}
  +export { loadLiveSpots as default };
  +

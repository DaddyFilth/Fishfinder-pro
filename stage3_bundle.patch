  +import { NextResponse } from 'next/server';
  +
  +export async function GET() {
  +  // Deterministic source on boot; tests can override
  via env
  +  const enabled =
  process.env.NEXT_PUBLIC_LIVE_SPOTS_ENABLED;
  +  const source = (enabled === 'true' || enabled ===
  '1') ? 'LIVE' : 'OFFLINE';
  +  return NextResponse.json({ source, timestamp: new
  Date().toISOString() });
  +}

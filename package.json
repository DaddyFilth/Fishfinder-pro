{
  "name": "seamcast",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/run-next.mjs dev --webpack",
    "build": "next build --webpack",
    "start": "node scripts/run-next.mjs start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "smoke": "node scripts/smoke.mjs",
    "env:sync": "node scripts/sync-env.mjs",
    "env:export": "node scripts/inject-env.mjs --export",
    "env:run": "node scripts/inject-env.mjs --",
    "test:all": "npm run test",
    "android:sync": "npx cap sync android",
    "android:debug": "npx cap sync android && cd android && ./gradlew assembleDebug",
    "android:apk": "bash scripts/build-android-apk.sh",
    "android:apk:check": "bash scripts/build-android-apk.sh --check",
    "android:apk:release": "bash scripts/build-android-apk.sh --release",
    "android:runner:setup": "bash scripts/setup-self-hosted-runner.sh",
    "scrape:odwc": "tsx scripts/scrape/odwc-accessible.ts --debug",
    "scrape:usace": "tsx scripts/scrape/usace-lakes.ts --debug"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/geolocation": "^8.2.3",
    "@supabase/server": "^1.9.2",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "@tanstack/react-query": "^5.104.3",
    "@types/leaflet": "^1.9.22",
    "@upstash/ratelimit": "^2.2.0",
    "@upstash/redis": "^1.39.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "axios": "^1.20.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dotenv-safe": "^9.1.0",
    "express-rate-limit": "^8.7.1",
    "framer-motion": "^14.3.0",
    "helmet": "^8.3.0",
    "idb": "^8.0.4",
    "ioredis": "^6.0.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.57.0",
    "next": "^16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-leaflet": "^5.0.0",
    "redis": "^6.3.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19",
    "csv-parse": "^7.0.2",
    "eslint": "^10",
    "eslint-config-next": "^16.4.2",
    "playwright-core": "^1.64.1",
    "shadcn": "^4.21.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.0"
  },
  "allowScripts": {
    "esbuild": true,
    "unrs-resolver": true
  },
  "overrides": {
    "xcode": {
      "uuid": "^11.1.1"
    }
  },
  "engines": {
    "node": ">=22.0.0"
  }
}

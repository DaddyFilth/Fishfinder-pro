# Fishfinder Pro - local/self-hosted Docker defaults. This file contains NO real secrets.
# Usage: cp .env.container.example .env.container, then fill in your real Supabase values.
# docker-compose.yml loads .env.container via env_file; keep .env.container out of git.

# --- Host-side ports ---
APP_PORT=3000
OLLAMA_PORT=11434

# --- AI models (pulled once by the one-shot ollama-init container into the shared ollama_data volume) ---
OLLAMA_MODEL=llama3.1
OLLAMA_VISION_MODEL=llama3.2-vision

# --- Internal Docker networking ---
# The app reaches Ollama over the compose network, not localhost.
OLLAMA_BASE_URL=http://ollama:11434/v1
APP_PUBLIC_URL=http://localhost:3000

# --- Supabase (replace with your real project values) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- External data APIs (safe public defaults) ---
NWS_BASE=https://api.weather.gov
USGS_BASE=https://api.waterdata.usgs.gov
OPEN_METEO_MARINE=https://marine-api.open-meteo.com/v1/marine

# AI provider model selection. Set this in Vercel; never commit API keys.
AI_CHAT_MODEL=llama-3.3-70b-versatile

# Fishfinder Pro - local Docker settings. This file contains NO real secrets.
# Copy to .env.container, replace required Supabase values, then run:
# docker compose --env-file .env.container up --build

# --- Host-side ports ---
APP_PORT=3000

# --- Redis (required by production rate limiting) ---
REDIS_URL=redis://redis:6379

# --- Supabase (replace with your real project values) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Optional AI integrations ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_VISION_MODEL=llama-4-scout-17b-16e-instruct
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- External data APIs (safe public defaults) ---
NWS_BASE=https://api.weather.gov
USGS_BASE=https://api.waterdata.usgs.gov
OPEN_METEO_MARINE=https://marine-api.open-meteo.com/v1/marine

APP_PUBLIC_URL=http://localhost:3000

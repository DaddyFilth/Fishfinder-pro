# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
__pycache__/

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Environment variables - never commit these
.env
.env.local
.env.development
.env.development.local
.env.test
.env.test.local
.env.production
.env.production.local

# Local Android / Capacitor build configuration
android/local.properties
android/.gradle/
android/build/
android/app/build/
android/captures/

# Editor swap files
*.swp
*.bak

# Keep GitHub Actions workflows tracked
!.github/
!.github/workflows/
!.github/workflows/*.yml
!.github/workflows/*.yaml

# Keep GitHub Actions workflow source tracked
!.github/
!.github/workflows/
!.github/workflows/*.yml
!.github/workflows/*.yaml

# Android release signing material — never commit
android/keystore/
*.jks
*.keystore

# Temporary encoded Android signing key — never commit
fishfinder-upload.jks.base64

# Generated Android artifacts — never commit
/apk-output/

# Repository-root scratch artifacts (debug dumps and one-off codemods).
# These are listed in .copilotignore too; keep them out of the tree entirely.
/build_out.txt
/eslint_out.txt
/tsc_out.txt
/purge.txt
/page.b64
/fishfinder-headers.txt
/audit_map.py
/fix_emojis.py
/fix_env.py
/fix_species.py
/fix_use_client.py
/fixer.py
# Kimi project memory
.kimi-memory/

# Supabase CLI local state (project ref, pooler URL, linked-project metadata).
# Regenerated by `supabase link`; never commit infrastructure details.
/supabase/.temp/
